# Public URL of the API, used by the browser (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: URL the Next.js server uses to reach the API (route handlers and server-rendered
# public pages). Defaults to NEXT_PUBLIC_API_URL. Set it when the server reaches the API on a
# different host than the browser does (e.g. inside Docker: http://api:4000).
API_INTERNAL_URL=

# Optional: default timezone when the API does not provide one.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/Bucharest

# Optional: set to "1" to register the service worker in `next dev` too (it is always
# registered in production builds).
NEXT_PUBLIC_ENABLE_SW_IN_DEV=
