{
  "name": "@ap/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith: identity, catalog, tracking, booking, payments, commissions",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ap/adapters": "workspace:*",
    "@ap/commission": "workspace:*",
    "@ap/contracts": "workspace:*",
    "@ap/db": "workspace:*",
    "@ap/i18n": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "drizzle-orm": "^0.44.7",
    "luxon": "^3.7.2",
    "nodemailer": "^8.0.11",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7"
  }
}
