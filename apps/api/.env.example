# Copy to .env and adjust. All values below work for local development.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/affiliate
# Public URL of the web app (links, QR codes, tickets and payment pages point here).
WEB_URL=http://localhost:3000
# Secret used to sign login sessions, ticket QR codes and ticket links. Use 32+ random bytes in production.
APP_SECRET=change-me-to-a-long-random-string
# fake: payments succeed on a local test page (no Stripe account needed). stripe: real Stripe.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Runs background jobs (outbox delivery, commission approval, expired holds) in this process.
WORKER_ENABLED=true
# console: login codes are printed in the API log. Real SMS/email providers come next.
NOTIFIER=console
# Your own sign-in email(s), comma-separated: they open the platform admin area (/admin).
PLATFORM_ADMIN_EMAILS=admin@demo.test
# true: operators can create an account themselves at /start. false: only by your invitation.
SELF_SIGNUP=true
# manual: you invoice operators' subscriptions yourself. stripe: Stripe Billing charges their card
# (needs STRIPE_SECRET_KEY, a Stripe Price id on each plan and a webhook to /webhooks/stripe/billing).
BILLING_PROVIDER=manual
STRIPE_BILLING_WEBHOOK_SECRET=
