{
  "name": "@ap/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Translations: one JSON file per language, shared by the web app, emails, SMS and API errors",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./loaders": "./src/loaders.ts",
    "./locales/*": "./src/locales/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "build": "node scripts/catalog.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/catalog.mjs --check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
