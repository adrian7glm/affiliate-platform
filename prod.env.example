# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it).
POSTGRES_PASSWORD=change-me
# Public addresses (behind your HTTPS reverse proxy).
NEXT_PUBLIC_API_URL=https://api.your-domain.ro
WEB_URL=https://your-domain.ro
# 32+ random characters: openssl rand -base64 48
APP_SECRET=
PLATFORM_ADMIN_EMAILS=you@your-domain.ro
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PROVIDER=manual
STRIPE_BILLING_WEBHOOK_SECRET=
EMAIL_PROVIDER=smtp
SMTP_URL=
EMAIL_FROM=Bilete <bilete@your-domain.ro>
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SELF_SIGNUP=true
# Optional: error reports.
SENTRY_DSN=
